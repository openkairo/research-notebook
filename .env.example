# Research Notebook — Einstellungen. Kopieren nach .env und anpassen: cp .env.example .env

# Anmeldung für die Oberfläche (HTTP Basic). Unbedingt setzen, wenn das Notebook im Netz erreichbar ist.
# Nur leer lassen, wenn ein vorgeschalteter Proxy (z. B. Traefik mit Basic-Auth) die Anmeldung übernimmt.
APP_USER=admin
APP_PASSWORD=

# Öffentliche Adresse, unter der das Notebook erreichbar ist (für die MCP-Links in den Einstellungen).
# Ohne Angabe wird sie aus der Anfrage abgeleitet.
PUBLIC_URL=

# Beispielinhalte beim allerersten Start: Thema „Brustgesundheit“ mit Begriffen, Medikamenten und Quellen (DE/EN/PL).
# 1 = einspielen, leer = mit einem leeren Thema starten. Wirkt nur bei leerer Datenbank.
EXAMPLE_DATA=

# Optional: Claude (Anthropic) für Übersetzungen und Zusammenfassungen, solange kein OpenAI-Schlüssel eingetragen ist.
# Den OpenAI-Schlüssel trägst du in der Oberfläche unter ⚙ Einstellungen ein — nicht hier.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Nur für docker-compose.traefik.yml: Domain und Basic-Auth-Hash (htpasswd -nbB benutzer passwort, jedes $ verdoppeln)
DOMAIN=notebook.example.org
BASIC_AUTH_USERS=
